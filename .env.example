# Free by default — get a key at https://console.groq.com/keys (no paid credits)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: use OpenAI instead (requires paid credits)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

CLASSIFY_TEMPERATURE=0
REPLY_TEMPERATURE=0.3
ESCALATE_THRESHOLD=0.45
COMPANY_NAME=NovaMart
